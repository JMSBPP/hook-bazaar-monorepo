# From feat/create-hook - hook-pkg submodules
[submodule "contracts/hook-pkg/lib/compose-extensions"]
	path = contracts/hook-pkg/lib/compose-extensions
	url = https://github.com/JMSBPP/compose-extensions
[submodule "contracts/hook-pkg/lib/Compose"]
	path = contracts/hook-pkg/lib/Compose
	url = https://github.com/Perfect-Abstractions/Compose
