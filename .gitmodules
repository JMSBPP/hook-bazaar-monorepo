	path = contracts/hook-pkg/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "contracts/hook-pkg/lib/forge-std"]
	path = contracts/hook-pkg/lib/forge-std
	url = https://github.com/foundry-rs/forge-std

