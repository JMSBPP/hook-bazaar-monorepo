#### 3D Geometric Element Example
```javascript
// Three.js example for 3D angular geometric shape
import * as THREE from 'three';

function createAngularGeometric(scene) {
  // Create angular geometric shape (low-poly)
  const geometry = new THREE.BoxGeometry(2, 2, 2);
  const material = new THREE.MeshStandardMaterial({
    color: 0xffd700, // Gold
    metalness: 0.8,
    roughness: 0.2,
    emissive: 0x000814, // Deep navy glow
    emissiveIntensity: 0.1
  });
  
  const cube = new THREE.Mesh(geometry, material);
  cube.rotation.set(0.5, 0.5, 0);
  
  // Angular rotation animation
  function animate() {
    cube.rotation.x += 0.01;
    cube.rotation.y += 0.01;
    requestAnimationFrame(animate);
  }
  
  scene.add(cube);
  animate();
}

// React Three Fiber example
import { Canvas, useFrame } from '@react-three/fiber';
import { Mesh } from 'three';

function AngularGeometric() {
  const meshRef = useRef<Mesh>(null);
  
  useFrame((state, delta) => {
    if (meshRef.current) {
      meshRef.current.rotation.x += delta * 0.5;
      meshRef.current.rotation.y += delta * 0.5;
    }
  });
  
  return (
    <mesh ref={meshRef}>
      <boxGeometry args={[2, 2, 2]} />
      <meshStandardMaterial 
        color="#FFD700" 
        metalness={0.8}
        roughness={0.2}
        emissive="#000814"
        emissiveIntensity={0.1}
      />
    </mesh>
  );
}
```

